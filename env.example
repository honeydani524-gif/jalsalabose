# 잘살아보세 환경변수 템플릿
# 복사: cp env.example .env.local
# ※ 이 파일이 없어도 앱은 완전히 동작합니다.

# 앱 표시 버전
VITE_APP_VERSION=0.1.0

# IndexedDB 스키마 버전 (src/data/db.ts 의 SCHEMA_VERSION 과 일치해야 함)
VITE_SCHEMA_VERSION=1

# 코인 시세 API (비워 두면 수동 시세 입력만 사용)
VITE_PRICE_API=https://api.coingecko.com/api/v3

# API 키 (공개 엔드포인트는 키 불필요)
VITE_PRICE_API_KEY=
